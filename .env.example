# Copiar para .env e ajustar. Nunca comitar o .env real (ver .gitignore).

# --- Base de dados ---
DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma_jogos?schema=public"

# --- Autenticação (Auth.js) ---
# Gerar com: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Bypass temporário só para a fase de construção: autentica sempre como o
# admin ativo mais antigo, sem exigir login. Remover/definir como "false"
# antes de expor a plataforma a utilizadores reais.
DISABLE_AUTH="false"

# --- Redis (locks, rate limiting) ---
REDIS_URL="redis://localhost:6379"

# --- Storage compatível com S3 (funciona com MinIO local, AWS S3 ou Cloudflare R2) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="plataforma-jogos-media"
# Para desenvolvimento local com "npx s3rver": tem de ser exatamente
# "S3RVER"/"S3RVER" — é a única conta que o s3rver aceita (conta fixa
# codificada no próprio pacote, não configurável). Noutro ambiente (MinIO,
# AWS S3, Cloudflare R2), usar as credenciais reais desse serviço.
STORAGE_ACCESS_KEY_ID="S3RVER"
STORAGE_SECRET_ACCESS_KEY="S3RVER"
STORAGE_FORCE_PATH_STYLE="true"
# URL pública para servir os ficheiros carregados (proxy/CDN em produção).
STORAGE_PUBLIC_URL="http://localhost:9000/plataforma-jogos-media"

# --- E-mail transacional (verificação de conta, recuperação de password) ---
# "console" escreve o e-mail nos logs (útil em desenvolvimento). "smtp" usa as
# variáveis SMTP_* abaixo.
MAIL_TRANSPORT="console"
MAIL_FROM="Plataforma de Jogos <no-reply@caetano.pt>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
